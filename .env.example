# OpenRouter API key — primary AI provider (24/7 online).
# Get one at https://openrouter.ai/keys
# Set this in your Vercel project (Settings → Environment Variables), never commit the real key.
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=google/gemini-2.5-flash
OPENROUTER_VISION_MODEL=google/gemma-4-31b-it:free

# Cloudflare Workers AI — fallback (free 10k requests/day, 24/7 online).
# Get Account ID from https://dash.cloudflare.com (sidebar right)
# Get API Token from https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_AI_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=
