# 9router — local AI proxy (primary provider, OpenRouter is fallback).
# Get your API key from 9router and paste it here.
NINEROUTER_API_KEY=
# Base URL — default is localhost. For production, set to your tunnel URL.
# NINEROUTER_BASE_URL=http://localhost:20128/v1

# OpenRouter API key — fallback when 9router is unavailable.
# Get one at https://openrouter.ai/keys
# Set this in your Vercel project (Settings → Environment Variables), never commit the real key.
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=z-ai/glm-5.2:free
OPENROUTER_VISION_MODEL=z-ai/glm-5.2:free

# Optional — change AI models without editing code (any OpenRouter model id works).
# Defaults to google/gemini-2.5-flash for both.
# OPENROUTER_CHAT_MODEL=google/gemini-2.5-flash
# OPENROUTER_VISION_MODEL=google/gemini-2.5-flash
