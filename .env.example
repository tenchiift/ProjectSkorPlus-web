# Supabase service_role key — REQUIRED for /api/admin-users (user cleanup).
# Server-side only: set in Vercel (Settings → Environment Variables) and in
# .env.local for `npm run dev`. Never prefix with VITE_, never commit it.
SUPABASE_SERVICE_ROLE_KEY=
# OpenRouter API key — used by the /api serverless functions (server-side only).
# Get one at https://openrouter.ai/keys
# Set this in your Vercel project (Settings → Environment Variables), never commit the real key.
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=google/gemini-2.5-flash
OPENROUTER_VISION_MODEL=google/gemma-4-31b-it:free
